# snapserver.conf template (ARCHITECTURE.md §2.4, §7). Rendered by
# entrypoint.sh via envsubst. Build-tested against Snapserver 0.35.0.
#
# No per-zone AirPlay streams are declared here (SPEC.md §6.4, §13):
# those are created/removed at runtime via Stream.AddStream/RemoveStream
# by the plugin (src/airplay/receiver.ts), not pre-declared in static
# config. This file only needs the MopidyOnly (Mopidy) source and the
# sandbox_dir that makes runtime airplay:// stream creation possible.

[stream]
# Mopidy's audio output is piped here (see mopidy.conf.template's [audio]
# section) -- entrypoint.sh creates this FIFO before starting either
# process. TODO(verify): confirm sampleformat matches what Mopidy's
# GStreamer pipeline actually emits.
source = pipe:///tmp/snapfifo?name=MopidyOnly&sampleformat=48000:16:2

# Announcement intake for other containers/processes (SPEC.md §6, §12) --
# a second, independent stream a zone can be manually switched to (src/
# routes.ts's /source endpoint, ALERTS_STREAM_ID) instead of muting the
# whole Snapclient, so a zone that's off the jukebox can still hear
# announcements. Snapcast's own `tcp server` source type (confirmed by
# build-testing): Snapserver listens on ALERTS_PORT and accepts ONE
# connection at a time, reading audio from whatever connects to it. Unlike
# the `pipe://` source above, this wants a real WAV stream (RIFF/WAVE
# header once, then raw PCM matching sampleformat) -- confirmed by
# build-testing that a bare headerless PCM stream is NOT what this source
# type expects (Snapcast's own docs' GStreamer example pipes through
# `wavenc` for exactly this reason).
source = tcp://0.0.0.0:4953?name=Alerts&sampleformat=48000:16:2&mode=server

# A third, deliberate "hear nothing at all" state (SPEC.md §6, §12) for a
# zone to be manually parked on (src/routes.ts's /source endpoint,
# "silence") -- e.g. a sleeping cabin, where even an announcement isn't
# wanted. All-zero bytes are digital silence in S16LE PCM, so entrypoint.sh
# feeds this pipe from `/dev/zero`, continuously, before Snapserver starts
# -- a genuine, always-available audio source, no synth/audio tooling
# needed.
source = pipe:///tmp/silencefifo?name=Silence&sampleformat=48000:16:2

# Auto-ducking combined output (SPEC.md §6, §12) -- what a zone actually
# means by "play the jukebox" (src/zone-sync.ts, src/routes.ts's own
# JUKEBOX_STREAM_ID, now "MusicAndAlerts", not the raw "MopidyOnly" stream
# directly). Snapcast's `meta` source type plays whichever listed source is
# currently active, highest-priority first -- confirmed by build-testing:
# with Alerts listed first, this stream automatically switches to it the
# moment audio starts arriving there, then automatically falls back to
# MopidyOnly the moment Alerts goes idle again, with no zone-reassignment
# or muting needed from any plugin. MopidyOnly and Alerts keep their own
# real codec (not `codec=null` as Snapcast's docs suggest for meta-only
# inputs) because they're still directly connectable in their own right (a
# zone manually switched to "Alerts" via the webapp targets the raw
# stream, not this one).
source = meta:///Alerts/MopidyOnly?name=MusicAndAlerts

# New (never-before-seen) Snapclients default here, not the raw MopidyOnly
# stream, so they get the auto-ducking behavior from their very first
# connection -- otherwise defaults to the first non-meta source
# (MopidyOnly).
default_source = MusicAndAlerts

# Runtime-created airplay streams (Stream.AddStream) must reference an
# executable inside this directory -- confirmed via research (SPEC.md
# §13) this is Snapserver >= 0.33.0's replacement for the earlier
# process-stream RPC restriction. entrypoint.sh places a shairport-sync
# wrapper here before starting Snapserver.
sandbox_dir = /app/sandbox

[http]
# Snapweb (image/Dockerfile) lives here: this is Snapcast's genuinely
# HTTP-capable server (real GET/POST + WS upgrade parsing, and the only
# section `doc_root` actually works under). Confirmed by build-testing:
# an earlier draft of this file put `[http]` on port 1705 to reuse it as
# src/snapserver-client.ts's control connection too -- despite the
# section's name, whatever's bound to 1705 in this Snapserver build does
# NOT parse real HTTP at all (a plain GET made it try to JSON-parse the
# request line itself and fail), so `doc_root` never actually served
# anything there. Moved to Snapcast's own real default port (1780) instead
# -- confirmed serving Snapweb's static files correctly once separated
# from the control port below.
enabled = true
bind_to_address = 0.0.0.0
port = 1780
doc_root = /usr/share/snapweb

# The actual control API src/snapserver-client.ts talks to: raw
# newline-terminated JSON-RPC over a plain TCP socket, not real HTTP
# (confirmed by build-testing, see `[http]` above) -- re-enabled now that
# `[http]` moved off this port and no longer collides with it.
[tcp-control]
enabled = true

# tcp-streaming (real audio delivery to snapclients, port 1704) is left at
# its default -- confirmed via `snapserver -hh` that it's a distinct,
# always-on listener unrelated to the control protocols above. Build-
# testing caught this: an earlier draft of this file set the deprecated
# [tcp] section's port to 1704, which collided with tcp-streaming's own
# default 1704 listener and made Snapserver fail to bind at startup.

# Deliberately NOT exposed via signalkAccessiblePorts (src/container.ts,
# SPEC.md §6 security note) -- these ports are LAN-facing via
# signalk-container's own networking, not routed through the SK server.
