# mopidy.conf template (ARCHITECTURE.md §2.4, §7). Rendered by
# entrypoint.sh via envsubst against the JUKEBOX_* env vars set in
# src/container.ts's buildConfig(). NOT verified against a real Mopidy
# build (no container runtime available when this was written).

[core]
data_dir = /data
cache_dir = /cache

[http]
enabled = true
hostname = 0.0.0.0
port = 6680

[audio]
# Routes Mopidy's output into the FIFO Snapserver reads as its Jukebox
# stream source (snapserver.conf.template). TODO(verify): confirm this
# GStreamer pipeline syntax and sample format actually match what
# snapserver.conf.template's `sampleformat=48000:16:2` expects, and that
# `sync=false` is the right choice for a pipe sink (avoids the filesink
# blocking on a reader that isn't Snapserver yet).
output = audioresample ! audioconvert ! audio/x-raw,rate=48000,channels=2,format=S16LE ! filesink location=/tmp/snapfifo sync=false

[local]
enabled = ${JUKEBOX_LOCAL_ENABLED}
media_dir = /music

[m3u]
# `playlists_dir` -- not `base_dir` -- is what Mopidy's m3u extension
# actually scans for playlist files (confirmed by reading its source,
# mopidy/_exts/m3u/playlists.py: `as_list()` iterates `playlists_dir`;
# `base_dir` is only used to resolve a playlist's own *relative* track
# paths, e.g. local music files referenced by a relative path within an
# m3u -- irrelevant here since every entry in the seeded playlist is an
# absolute http(s) URL). Left unset, `playlists_dir` falls back to
# Mopidy's own extension data dir (`Extension.get_data_dir()`, under
# `[core] data_dir` above) -- confirmed live this is where an unrelated,
# pre-existing "[Radio Streams].m3u8" file was actually being served
# from instead of the seeded playlist below, even with `base_dir` set
# correctly (a real bug in an earlier version of this file: setting only
# `base_dir` looked plausible from Mopidy's own default ext.conf
# defaulting `base_dir` to `$XDG_MUSIC_DIR`, but that default is a red
# herring -- it's `playlists_dir`, defaulted to empty in the same
# ext.conf, that actually matters).
#
# Both point at /data/playlists, not /music: /music is the local-library
# bind mount (container.ts's libraryMount), which is entirely
# conditional on backends.local.enabled and a configured libraryPath --
# with local disabled (a real, common config, e.g. a radio-only
# install), /music isn't mounted at all, so a playlist placed there
# would never survive a container recreate and might not even be a real
# directory. /data is mounted unconditionally (container.ts's
# dataMount), so playlists (including the seeded internet-radio.m3u,
# entrypoint.sh) persist regardless of the local backend's own state.
playlists_dir = /data/playlists
base_dir = /data/playlists

[file]
# Mopidy's built-in file extension has the same $XDG_MUSIC_DIR problem in
# its default media_dirs (confirmed by build-testing) -- override for the
# same reason as [m3u] above.
media_dirs =
    /music|Music

# No [tunein]: dropped from the image (see Dockerfile's base-image note --
# incompatible with Mopidy 4.x, tracked upstream, no fix yet). Mopidy's
# built-in [stream] extension (enabled by default, no config needed here)
# still plays any http(s) audio URL directly -- station browsing/search
# is what's lost, not playback. JUKEBOX_RADIO_ENABLED (settings.backends.
# radio.enabled) instead gates entrypoint.sh seeding a default 100-
# station internet-radio.m3u playlist into [m3u]'s base_dir above, a
# real (if smaller) substitute for TuneIn's station directory. Re-add a
# [tunein] block here if it ever regains Mopidy-4 compatibility upstream.

[spotify]
enabled = ${JUKEBOX_SPOTIFY_ENABLED}
client_id = ${JUKEBOX_SPOTIFY_CLIENT_ID}
client_secret = ${JUKEBOX_SPOTIFY_CLIENT_SECRET}
# TODO(SPEC.md §5, §13): Mopidy-Spotify has an open upstream login5 auth
# issue as of this writing (mopidy-spotify#437) -- basic playback may not
# work even with correct client_id/client_secret. Not something this
# config can work around.

[musicbox_webclient]
# Replaces Mopidy-Iris until it publishes a Mopidy-4-compatible release
# (see Dockerfile's base-image note). Served at /musicbox_webclient/ on
# this same Mopidy HTTP port, published directly to the LAN by
# container.ts (not reverse-proxied -- its UI needs a WebSocket this
# plugin's proxy can't forward).
enabled = true
